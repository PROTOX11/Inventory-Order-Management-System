# =============================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to Git!
# =============================================

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=inventory_db

# Full DB connection URL for the Flask backend
# Note: 'db' is the Docker Compose service name — it acts as the hostname
DATABASE_URL=postgresql://postgres:changeme123@db:5432/inventory_db

# Which frontend URLs can call the backend API (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# Flask secret key — change this in production!
SECRET_KEY=super-secret-key-change-this-in-production

# Frontend: where to send API requests
VITE_API_BASE_URL=http://localhost:8000
